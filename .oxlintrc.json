{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "vue"
    ],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "browser": true,
        "es2024": true
    },
    "ignorePatterns": [
        "dist/**",
        "coverage/**",
        "demo/**"
    ]
}
