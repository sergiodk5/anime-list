{
    "name": "anime-list",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "build:content": "vite build --config vite.content.config.ts",
        "build:manifest": "node dist/src/manifest/index.js > dist/manifest.json",
        "build:ext": "npm run clear-dist && npm run build && npm run build:content && npm run build:manifest",
        "build-only": "vite build",
        "preview": "vite preview",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:unit:coverage:ui": "vitest run --coverage && open coverage/index.html",
        "test:e2e": "playwright test --pass-with-no-tests",
        "type-check": "vue-tsc --build --force",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --deny-warnings",
        "format": "oxfmt src/",
        "format:check": "oxfmt --check src/",
        "clear-dist": "rm -rf dist"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@vue/devtools-api": "^8.2.1",
        "@vueuse/core": "^15.0.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.4.0",
        "vue3-toastify": "^0.2.9"
    },
    "devDependencies": {
        "@pinia/testing": "^2.0.1",
        "@playwright/test": "^1.64.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/chrome": "^0.3.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/ui": "^5.0.3",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.1.2",
        "npm-run-all2": "^9.0.3",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.3.13"
    }
}
